# Local development environment for Whereabouts.
#
# Copy this file to .env. Both docker-compose (for the MariaDB/Postgres
# container) and the Go app itself (via godotenv, see loadEnvFile in main.go)
# read it automatically — no exporting needed:
#
#   docker-compose up -d
#   go run .
#
# Real environment variables always take priority over .env if both are set.
# See loadDBConfig in main.go for the full list of variables the app reads.

# DB_DRIVER selects the backend: mariadb (default), postgres, or sqlite.
DB_DRIVER=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test
DB_NAME=wherewhat

# Used by sqlite only — path to the database file, created automatically
# (along with its parent directory) on first run.
# DB_SQLITE_PATH=./data/wherewhat.db

PORT=8080
COOKIE_SECURE=false

# Credentials for the demo user seeded on first run
DEMO_USERNAME=user
DEMO_PASSWORD=pass
