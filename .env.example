# Local development environment for Whereabouts.
#
# Copy this file to .env. Both docker-compose (for the MariaDB container) and
# the Go app itself (via godotenv, see loadEnvFile in main.go) read it
# automatically — no exporting needed:
#
#   docker-compose up -d
#   go run .
#
# Real environment variables always take priority over .env if both are set.
# See loadDBConfig in main.go for the full list of variables the app reads.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=test
DB_PASSWORD=test
DB_NAME=wherewhat

PORT=8080
COOKIE_SECURE=false
